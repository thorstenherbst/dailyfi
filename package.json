{
  "name": "dailyfi",
  "version": "0.0.0",
  "scripts": {
    "nx": "nx",
    "start": "nx serve dailyfi",
    "build": "nx build dailyfi",
    "watch": "nx build dailyfi --watch --configuration development",
    "test": "nx run-many -t test",
    "test:watch": "nx test --watch",
    "test:tz": "TZ=Australia/Sydney nx run-many -t test",
    "lint": "nx run-many -t lint",
    "graph": "nx graph",
    "db:reset": "supabase db reset",
    "db:types": "supabase gen types typescript --local > libs/shared/data-access-supabase/src/lib/database.types.ts",
    "format": "prettier --write \"{apps,libs}/**/*.{ts,html,scss}\""
  },
  "private": true,
  "packageManager": "npm@11.19.0",
  "dependencies": {
    "@angular/common": "^22.1.0",
    "@angular/compiler": "^22.1.0",
    "@angular/core": "^22.1.0",
    "@angular/forms": "^22.1.0",
    "@angular/platform-browser": "^22.1.0",
    "@angular/router": "^22.1.0",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@supabase/supabase-js": "^2.116.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular-devkit/core": "^22.1.8",
    "@angular-devkit/schematics": "^22.1.8",
    "@angular/build": "^22.1.8",
    "@angular/cli": "^22.1.8",
    "@angular/compiler-cli": "^22.1.0",
    "@eslint/js": "^9.8.0",
    "@nx/angular": "24.0.4",
    "@nx/eslint": "24.0.4",
    "@nx/eslint-plugin": "24.0.4",
    "@nx/js": "24.0.4",
    "@nx/workspace": "24.0.4",
    "@schematics/angular": "^22.1.8",
    "@swc/helpers": "~0.5.18",
    "@types/node": "^24.19.2",
    "@typescript-eslint/utils": "^8.58.0",
    "angular-eslint": "^22.5.0",
    "eslint": "^9.8.0",
    "eslint-config-prettier": "^10.0.0",
    "jsdom": "^28.0.0",
    "nx": "24.0.4",
    "prettier": "^3.8.1",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.58.0",
    "vitest": "^4.0.8",
    "zone.js": "^0.16.3"
  }
}
